# Rename to .dev.vars for local `wrangler dev`.
# D1 is configured with remote = true in wrangler.toml — local dev uses the live database.
OPENAI_API_KEY=

# FatSecret Platform API (https://platform.fatsecret.com)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Production Worker secrets (never commit .dev.vars):
#   npx wrangler secret put OPENAI_API_KEY
#   npx wrangler secret put FATSECRET_CLIENT_ID
#   npx wrangler secret put FATSECRET_CLIENT_SECRET
