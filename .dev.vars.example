# Rename to .dev.vars for local `wrangler dev`.
# D1 is configured with remote = true in wrangler.toml — local dev uses the live database.
OPENAI_API_KEY=

# FatSecret Platform API (https://platform.fatsecret.com)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Local dev uses your home IP — set so audit chips show "Your computer".
FATSECRET_LOCAL_EGRESS=1

# Home relay (optional): when deployed Worker is IP-blocked, it calls your machine.
# 1. Run `npm run dev` (API on 8787).
# 2. Expose it: `cloudflared tunnel --url http://127.0.0.1:8787` (copy the https URL, no trailing slash).
# 3. Put the same relay secret in .dev.vars and production Worker secrets.
FATSECRET_RELAY_URL=
FATSECRET_RELAY_SECRET=

# Production Worker secrets (never commit .dev.vars):
#   npx wrangler secret put OPENAI_API_KEY
#   npx wrangler secret put FATSECRET_CLIENT_ID
#   npx wrangler secret put FATSECRET_CLIENT_SECRET
#   npx wrangler secret put FATSECRET_RELAY_URL
#   npx wrangler secret put FATSECRET_RELAY_SECRET
