{
  "name": "checkmark-fitness",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:ensure-assets && npm run dev:clean-ports && concurrently -n web,api \"vite\" \"wrangler dev\"",
    "dev:clean-ports": "lsof -nP -iTCP:8787 -sTCP:LISTEN -t 2>/dev/null | xargs kill -9 2>/dev/null || true",
    "dev:vite": "vite",
    "dev:all": "npm run dev",
    "dev:ensure-assets": "test -f dist/index.html || npm run build",
    "build": "tsc && vite build",
    "build:prod": "tsc && vite build --mode production",
    "preview": "vite preview",
    "dev:worker": "npm run dev:ensure-assets && wrangler dev",
    "migrate:lift": "node scripts/migrate-liftcalc.mjs",
    "seed:sql": "node scripts/seed-d1.mjs",
    "seed:local": "node scripts/seed-d1.mjs && wrangler d1 execute checkmark-fitness --local --file=seed-generated.sql",
    "seed:remote": "node scripts/seed-d1.mjs && wrangler d1 execute checkmark-fitness --remote --file=seed-generated.sql",
    "db:migrate:local": "wrangler d1 migrations apply checkmark-fitness --local",
    "db:migrate:remote": "wrangler d1 migrations apply checkmark-fitness --remote",
    "deploy": "npm run pages:deploy",
    "pages:deploy": "npm run build:prod && wrangler deploy && wrangler pages deploy dist --project-name mxn-checkmark-fitness --branch main --commit-dirty=true"
  },
  "dependencies": {
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260507.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "wrangler": "^4.90.0"
  }
}
